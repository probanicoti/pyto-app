# Copy this file to .env.local for local dev (with `vercel dev`),
# and add the same keys under Vercel → Project → Settings → Environment Variables.

# At least one of the three news keys is required. All are free tier.
GNEWS_API_KEY=
NEWSDATA_API_KEY=
NEWSAPI_ORG_KEY=

# Required — free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=
